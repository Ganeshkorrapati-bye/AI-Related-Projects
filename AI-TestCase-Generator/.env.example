# --- OpenAI configuration -------------------------------------------------
# Required: your OpenAI API key. Never commit the real value.
OPENAI_API_KEY=sk-your-key-here

# Optional: model to use (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: override the OpenAI base URL (e.g. for Azure/proxies). Leave blank
# for the default OpenAI endpoint.
OPENAI_BASE_URL=

# Optional: generation tuning.
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=8000
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=3

# Optional: logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
